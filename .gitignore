.env
*.db
*.db-wal
*.db-shm
__pycache__/
*.pyc
access.log

# Scratch renders. The committed sample lives in assets/.
/sample-og.png

# Generated by the running service and downloaded only for marketplace uploads.
# Deliberately not committed: a checked-in copy drifts out of sync with the
# live API, and /openapi.json is always authoritative.
/docforge-openapi.json

# Business notes, deployment credentials and go-to-market planning.
# Local only — never publish.
/private/

# Acceptance-run artefacts. The inputs under tests/fixtures/ are committed so
# the run is reproducible; everything the API hands back is not — it is large,
# binary, and regenerated on every run.
/tests/fixtures/out-*
/tests/fixtures/mcp-*
/tests/fixtures/v-*.pdf
/tests/fixtures/*.json
/tests/fixtures/h*.txt
