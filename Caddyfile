# Hostname comes from FORGE_DOMAIN in .env — see .env.example.
#
# If you don't own a domain, sslip.io resolves <dashed-ip>.sslip.io to that IP
# with no signup. It sits on the Public Suffix List, so Let's Encrypt treats
# each subdomain as its own registrable domain and issues normally:
#
#     FORGE_DOMAIN=203-0-113-45.sslip.io
#
# Point it at a real domain later; nothing else needs to change.

{$FORGE_DOMAIN} {
	encode zstd gzip

	# Uploads are capped well under Gotenberg's comfort zone. Without this a
	# single very large POST can pin the host.
	request_body {
		max_size 32MB
	}

	# MCP clients connect here. Same certificate and hostname as the REST API,
	# so there is one URL to publish and nothing extra to provision.
	handle /mcp* {
		reverse_proxy mcpserver:8100 {
			transport http {
				read_timeout 180s
				write_timeout 180s
			}
		}
	}

	handle {
		reverse_proxy gateway:8000 {
			transport http {
				# Office conversions legitimately take a while on cold start.
				read_timeout 180s
				write_timeout 180s
			}
		}
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 3
		}
		format json
	}
}
