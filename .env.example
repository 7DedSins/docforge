# Copy to .env and fill in. .env is gitignored.
#
#   cp .env.example .env

# Public hostname Caddy will obtain a TLS certificate for.
# No domain? Use sslip.io with your server's IP, dashes for dots:
#   FORGE_DOMAIN=203-0-113-45.sslip.io
FORGE_DOMAIN=your-host.example.com

# Which host address Caddy binds to.
#
# Use 0.0.0.0 on a normal server. Set a specific IP only if something else
# already holds :80/:443 on another interface — for example Tailscale Serve,
# which binds the tailnet address and will collide with a wildcard bind.
FORGE_BIND_IP=0.0.0.0

# API key the MCP server presents to the gateway. Generate one after the first
# start, then put it here and restart:
#
#   docker exec forge-gateway python /app/forgectl.py issue \
#       --label mcp-internal --plan unlimited
FORGE_MCP_KEY=
