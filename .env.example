# Copy to .env and fill in. .env is gitignored.
#
#   cp .env.example .env

# Public hostname Caddy will obtain a TLS certificate for.
# No domain? Use sslip.io with your server's IP, dashes for dots:
#   DOCFORGE_DOMAIN=203-0-113-45.sslip.io
DOCFORGE_DOMAIN=your-host.example.com

# Which host address Caddy binds to.
#
# Use 0.0.0.0 on a normal server. Set a specific IP only if something else
# already holds :80/:443 on another interface — for example Tailscale Serve,
# which binds the tailnet address and will collide with a wildcard bind.
DOCFORGE_BIND_IP=0.0.0.0

# API key the MCP server presents to the gateway. Generate one after the first
# start, then put it here and restart:
#
#   docker exec docforge-gateway python /app/docforgectl.py issue \
#       --label mcp-internal --plan unlimited
DOCFORGE_MCP_KEY=

# Only needed once you list on RapidAPI. Copy the Proxy Secret from your
# RapidAPI provider dashboard. While this is set, requests without a matching
# X-RapidAPI-Proxy-Secret header are refused — which is what stops people
# reading your base URL off the listing and calling the API for free.
#
# Leave blank to accept direct requests (correct while self-hosting).
DOCFORGE_RAPIDAPI_PROXY_SECRET=

# The same idea for MCP marketplaces (AgenticMarket, MCPize). They take the
# payment and forward the call with this secret; without the check, callers
# reach /mcp directly and the marketplace never bills. Their listing review
# tests for it.
#
# Only tools/call is gated. initialize and tools/list stay open so review can
# read your tool descriptions and uptime probes keep working.
#
# Leave blank to accept unauthenticated MCP calls (correct while self-hosting).
DOCFORGE_MCP_PROXY_SECRET=

# Comma-separated header names to accept the secret in. Blank uses the built-in
# list, which already covers AgenticMarket and MCPize. Set it only for a
# marketplace that uses some other header.
DOCFORGE_MCP_SECRET_HEADERS=

# The DocForge key marketplace traffic is metered against. Marketplace
# consumers authenticate to the marketplace, not to us, so they never hold a
# DocForge key — their calls still need an identity here for usage to attach to.
# Issue one and paste it:
#
#   docker exec docforge-gateway python /app/docforgectl.py issue \
#       --label rapidapi --plan unlimited
#
# Use an unlimited plan: the marketplace already enforces its own per-consumer
# quotas, and a second cap here would cut every subscriber off at once.
DOCFORGE_RAPIDAPI_KEY=
